<!DOCTYPE html>
<html>
  <head>
    <title>EcommerceStore</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <header style="padding: 1rem; border-bottom: 1px solid #ddd; margin-bottom: 1rem;">
      <nav>
        <%= link_to 'Home', root_path %>
        <% if logged_in? %>
          | Hello, <strong><%= current_user['name'] %></strong>
          | <%= button_to 'Logout', logout_path, method: :delete, form: { style: 'display:inline' } %>
        <% else %>
          | <%= link_to 'Login', login_path %>
          | <%= link_to 'Sign up', signup_path %>
        <% end %>
      </nav>
    </header>

    <% if notice %>
      <div class="notice" style="background-color:#d4edda; padding:10px; margin:10px 0; border-radius:5px;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert" style="background-color:#f8d7da; padding:10px; margin:10px 0; border-radius:5px;">
        <%= alert %>
      </div>
    <% end %>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
