<!DOCTYPE html>
<html>
  <head>
    <title>EcommerceStore</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Stylesheets -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Rails 7 JS with importmap -->
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Flash messages -->
    <% if notice %>
      <div class="notice" style="background-color:#d4edda; padding:10px; margin:10px 0; border-radius:5px;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert" style="background-color:#f8d7da; padding:10px; margin:10px 0; border-radius:5px;">
        <%= alert %>
      </div>
    <% end %>

    <!-- Main content -->
    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
