<h1>Buy <%= @product.name %></h1>

<p>Price: <%= number_to_currency(@product.price) %></p>
<p>Available Stock: <%= @product.stock %></p>

<%= form_with url: purchase_product_path(@product), method: :post, local: true do |f| %>
  <div class="form-group">
    <%= f.label :name, "Your Name" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :address, "Shipping Address" %>
    <%= f.text_area :address, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :quantity, "Quantity" %>
    <%= f.number_field :quantity, value: 1, min: 1, max: @product.stock, required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit "Place Order", class: "buy-submit-button" %>
  </div>
<% end %>
