<%= form_with model: product, local: true do |f| %>
  <p>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </p>

  <p>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </p>

  <p>
    <%= f.label :price %><br>
    <%= f.number_field :price, step: 0.01 %>
  </p>

  <p>
    <%= f.label :stock %><br>
    <%= f.number_field :stock %>
  </p>

  <p>
  <%= f.label :image %><br>
  <%= f.file_field :image %>
</p>

  <p>
    <%= f.submit product.new_record? ? "Create Product" : "Update Product" %>
  </p>
<% end %>
