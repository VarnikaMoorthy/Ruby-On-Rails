<h1>Products</h1>

<%= link_to 'Add New Product', new_product_path, class: "add-product-link" %>

<% @products.each do |product| %>
  <div class="product-card">
    <h2><%= link_to product.name, product_path(product) %></h2>
    <p><%= product.description %></p>
    <p>Price: <%= number_to_currency(product.price) %></p>
    <p>Stock: <%= product.stock %></p>

    <div class="product-actions">
      <%= link_to 'Edit', edit_product_path(product), class: "edit-link" %>

      <%= button_to 'Delete', product_path(product),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this product?" },
          class: "delete-button" %>
    </div>
  </div>
<% end %>
